DATABASE_URL=postgresql://user:password@pooled-host/database
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=1800
UPLOAD_STORAGE_PATH=backend/storage/uploads
CHROMA_STORAGE_PATH=backend/storage/chroma
MAX_UPLOAD_BYTES=10485760
MAX_CSV_ROWS=50000
MAX_CSV_COLUMNS=200
MAX_CONCURRENT_INDEX_JOBS=2
MAX_QUESTIONS_PER_MINUTE=12
